rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Core security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'thumodzit@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'displayName', 'email']) &&
        data.keys().hasOnly(['userId', 'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt']) &&
        data.userId is string && data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() <= 180 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64));
    }

    function isValidUserMemory(data) {
      return data.keys().hasAll(['userId', 'senderName', 'content']) &&
        data.keys().hasOnly(['userId', 'senderName', 'content', 'costumeName', 'era', 'createdAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 1500 &&
        (!('costumeName' in data) || (data.costumeName is string && data.costumeName.size() <= 120)) &&
        (!('era' in data) || (data.era is string && data.era.size() <= 100)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Private User Profile (Strict PII isolation: only owner or admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // User Character subcollection
      match /character/{charId} {
        allow get: if isValidId(userId) && isValidId(charId) && isOwner(userId);
        allow create, update: if isValidId(userId) && isValidId(charId) && isOwner(userId) &&
          incoming().keys().size() <= 20;
        allow delete: if isValidId(userId) && isValidId(charId) && isOwner(userId);
      }

      // User Outfits subcollection
      match /outfits/{outfitId} {
        allow get: if isValidId(userId) && isValidId(outfitId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create, update: if isValidId(userId) && isValidId(outfitId) && isOwner(userId) &&
          incoming().keys().size() <= 25;
        allow delete: if isValidId(userId) && isValidId(outfitId) && isOwner(userId);
      }

      // User Experience Journal subcollection
      match /journal/{journalId} {
        allow get: if isValidId(userId) && isValidId(journalId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create, update: if isValidId(userId) && isValidId(journalId) && isOwner(userId) &&
          incoming().keys().size() <= 20 &&
          (!('emotionalNote' in incoming()) || (incoming().emotionalNote is string && incoming().emotionalNote.size() <= 2000));
        allow delete: if isValidId(userId) && isValidId(journalId) && isOwner(userId);
      }
    }

    // Public Community Memories (Strict authorship & size bounds)
    match /memories/{memoryId} {
      allow get: if isValidId(memoryId);
      allow list: if true;
      allow create: if isValidId(memoryId) && isVerified() && isValidUserMemory(incoming());
      allow update: if isValidId(memoryId) && isVerified() && isValidUserMemory(incoming()) &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().userId == existing().userId;
      allow delete: if isValidId(memoryId) && isVerified() &&
        (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
